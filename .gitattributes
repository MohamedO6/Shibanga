# Evidence records, proofs and scientific bundles must retain their exact bytes.
data/** -text whitespace=cr-at-eol
assets/** -text whitespace=cr-at-eol

# Source line endings are consistent across Windows and CI.
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.md text eol=lf
# The optical-check result fingerprints this analysis plan.
pipeline/season_check_plan.json text eol=lf
