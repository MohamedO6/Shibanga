{"total": 55.115, "intro": 2.0, "logo": 18.11, "notes": [33.5, 34.8], "all": 51.619, "cities": [6.35, 7.45, 9.31], "lines": [{"id": "O1", "who": 1, "start": 2.0, "end": 6.18, "text": "حاسس بيها؟ لأ؟ طبيعي... محدش حاسس.", "wt": [[2.0, 2.48], [2.48, 3.2800000000000002], [3.2800000000000002, 3.6], [4.34, 4.88], [4.88, 5.640000000000001], [5.640000000000001, 6.18]]}, {"id": "L01", "who": 2, "start": 6.35, "end": 11.77, "text": "جاكرتا بتهبط. مكسيكو سيتي بتهبط. وتركيا اتشقّت تلتمية كيلو!", "wt": [[6.35, 6.97], [6.97, 7.449999999999999], [7.449999999999999, 8.25], [8.25, 8.51], [8.51, 9.309999999999999], [9.309999999999999, 10.07], [10.07, 10.489999999999998], [10.489999999999998, 10.89], [10.89, 11.77]]}, {"id": "L02", "who": 3, "start": 11.77, "end": 15.51, "text": "والدلتا عندنا؟ بتهبط لحد حداشر ملّي كل سنة.", "wt": [[11.77, 12.21], [12.21, 12.629999999999999], [12.629999999999999, 13.57], [13.57, 13.809999999999999], [13.809999999999999, 14.41], [14.41, 14.73], [14.73, 14.95], [14.95, 15.51]]}, {"id": "L03", "who": 1, "start": 15.51, "end": 18.11, "text": "ومحدش شايف ده... غير نيسار.", "wt": [[15.51, 15.95], [15.95, 16.509999999999998], [16.509999999999998, 16.79], [16.79, 17.65], [17.65, 18.11]]}, {"id": "L04", "who": 2, "start": 18.11, "end": 22.33, "text": "أندولا بتخلّي أي حد يشوفه، ويسمعه، ويفهمه.", "wt": [[18.11, 18.61], [18.61, 18.95], [18.95, 19.41], [19.41, 19.77], [19.77, 20.13], [20.13, 20.73], [20.73, 21.47], [21.47, 22.33]]}, {"id": "L05", "who": 3, "start": 22.33, "end": 25.29, "text": "شغّل داتا نيسار الحقيقية... كأنها فيلم.", "wt": [[22.33, 22.85], [22.85, 23.049999999999997], [23.049999999999997, 23.47], [23.47, 24.25], [24.25, 24.89], [24.89, 25.29]]}, {"id": "L06", "who": 2, "start": 25.29, "end": 27.43, "text": "شوف الزرع والمية من الفضاء.", "wt": [[25.29, 25.75], [25.75, 26.229999999999997], [26.229999999999997, 26.729999999999997], [26.729999999999997, 26.909999999999997], [26.909999999999997, 27.43]]}, {"id": "L07", "who": 1, "start": 27.43, "en